{
  "name": "pie",
  "private": true,
  "bin": {
    "pie": "./bin/pie"
  },
  "type": "module",
  "scripts": {
    "prepare": "effect-language-service patch",
    "check": "tsgo -p tsconfig.check.json --noEmit",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "bun test",
    "effect:diagnostics": "bunx effect-language-service diagnostics --project tsconfig.json --format pretty --progress",
    "cli": "bun run src/cli.ts",
    "wakeword:install-feature-models": "bun run scripts/install-openwakeword-feature-models.ts",
    "gate": "bun run check && bun run effect:diagnostics && bun run lint && bun run format:check && bun run test"
  },
  "dependencies": {
    "@effect/ai-anthropic": "https://pkg.pr.new/Effect-TS/effect-smol/@effect/ai-anthropic@fe2cab2",
    "@effect/ai-openai": "https://pkg.pr.new/Effect-TS/effect-smol/@effect/ai-openai@fe2cab2",
    "@effect/platform-bun": "https://pkg.pr.new/Effect-TS/effect-smol/@effect/platform-bun@fe2cab2",
    "dbus-next": "^0.10.2",
    "effect": "https://pkg.pr.new/Effect-TS/effect-smol/effect@fe2cab2",
    "onnxruntime-web": "1.22.0"
  },
  "devDependencies": {
    "@effect/language-service": "^0.71.0",
    "@types/bun": "latest",
    "oxfmt": "^0.26.0",
    "oxlint": "^1.41.0",
    "typescript": "^5.9.3"
  }
}
